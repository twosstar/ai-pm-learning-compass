APP_NAME=AI PM Learning Copilot Public Edition
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
STORAGE_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PATH=./data/chroma

# Optional OpenAI-compatible service for generated teaching and feedback.
# Leave blank to use the application's built-in fallback behavior.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4.1-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# The public edition has no browser connection or course collection settings.
